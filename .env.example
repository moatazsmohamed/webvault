# ─────────────────────────────────────────────────────────────────────────────
# WebVault — environment template
# Copy to `.env.local` (never commit it). Values below are placeholders.
# Generate every secret with:  node scripts/gen-secrets.mjs
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Project Settings → API) ---------------------------------------
# Project ref / URL. Used server-side only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role key. Server-side ONLY. Never exposed to the browser, never in a
# client bundle, never logged. It bypasses RLS, so the app is the only gatekeeper.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# --- Credential vault encryption ---------------------------------------------
# 32-byte AES-256 key, base64. Encrypts every stored username/password/note.
# Losing this key makes stored credentials unrecoverable. Rotating it requires
# re-encrypting existing rows (see README → Key rotation).
WEBVAULT_ENC_KEY=base64-32-bytes-here

# --- Session signing ----------------------------------------------------------
# HMAC key for the short-lived "vault unlocked" cookie.
WEBVAULT_SESSION_SECRET=64-hex-chars-here

# --- First-run setup ----------------------------------------------------------
# Optional extra gate for /setup. If set, the setup page requires it.
# Leave unset after the admin account exists — setup self-closes when a user exists.
WEBVAULT_SETUP_KEY=

# Reopens account creation after the first run: PUT /api/auth/login succeeds for a
# new account when setup_key matches this value. Leave empty unless you are adding
# a second device or account, then clear it again.
WEBVAULT_INVITE_KEY=

# --- Password recovery by email -----------------------------------------------
# Optional. Without both values the /reset-password flow stays switched off and the
# login page shows no recovery link. Resend is the transport (one HTTP call, no SMTP
# dependency): create a free key at resend.com/api-keys and use a verified sender.
# The first Resend sandbox address (onboarding@resend.dev) only delivers to the
# address your own Resend account was created with — enough for a single-owner app.
RESEND_API_KEY=
RESEND_FROM=WebVault <onboarding@resend.dev>

# Test-only escape hatch: when RESEND_API_KEY is unset and NODE_ENV is not
# "production", the message is appended to this file instead of being sent, so the
# e2e suite can read a code back. Refused outright in production.
WEBVAULT_MAIL_OUTBOX=

# --- Deployment ---------------------------------------------------------------
# Public origin, used for absolute links in exports and cookies `Secure` logic.
NEXT_PUBLIC_APP_URL=http://localhost:3000
